# cove-cp, the self-hosted Cove Code control plane
# Copy to .env and fill in values before running `vp run --filter cove-cp start`
# or `docker compose -f docker-compose.example.yml up`.

# HTTP listen bind host/port
HOST=0.0.0.0
PORT=8787

# Public base URL reachable by clients & environment hosts (no trailing slash)
COVE_CP_PUBLIC_URL=https://cp.example.com

# Persistent directory for auto-generated Ed25519 mint keys, tunnel secrets, and libp2p peer identity
COVE_CP_DATA_DIR=/data/cove-cp

# PostgreSQL connection string
DATABASE_URL=postgres://cove:cove@localhost:5432/cove_cp
# Automatically apply SQL migrations from infra/cp/migrations/postgres on boot (default: true)
COVE_CP_AUTO_MIGRATE=true

# Standard external OIDC authentication (Discovery + JWKS + PKCE + Device Flow)
# Supports Keycloak, Authentik, Authelia, Dex, ZITADEL, Auth0, Okta, Google, Entra ID, etc.
COVE_CP_OIDC_ISSUER=https://auth.example.com/realms/cove
COVE_CP_OIDC_CLIENT_ID=cove-app
# Comma-separated scopes advertised to clients (default: openid,profile,email)
COVE_CP_OIDC_SCOPES=openid,profile,email
# Optional explicit audience and JWKS URI overrides (defaults to OIDC discovery)
# COVE_CP_OIDC_AUDIENCE=cove-app
# COVE_CP_OIDC_JWKS_URI=

# libp2p tunnel gateway
COVE_CP_LIBP2P_ENABLED=true
# Comma-separated libp2p listen multiaddrs
COVE_CP_LIBP2P_LISTEN=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws
# Comma-separated public multiaddrs advertised in /.well-known/cove-control-plane
# Example: /ip4/203.0.113.10/tcp/4001,/dns4/cp.example.com/tcp/4002/wss
# COVE_CP_LIBP2P_ANNOUNCE=
# Secret used to derive per-environment tunnel connector tokens (auto-generated in COVE_CP_DATA_DIR if omitted)
# COVE_CP_TUNNEL_SECRET=
# Optional subdomain routing base domain (defaults to path-prefix /t/<endpointKey>/ when unset)
# COVE_CP_TUNNEL_BASE_DOMAIN=tunnels.example.com
COVE_CP_TUNNEL_NAMESPACE=selfhosted
COVE_CP_MAX_MANAGED_TUNNELS=20

# Optional explicit Ed25519 keys for relay mint tokens (auto-generated in COVE_CP_DATA_DIR if omitted)
# COVE_CP_SIGNING_PRIVATE_KEY=
# COVE_CP_SIGNING_PUBLIC_KEY=

# Optional Apple Push Notification service (APNs)
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# COVE_CP_APNS_JOB_SECRET=

# Optional Firebase Cloud Messaging (Android push) service account JSON
# FCM_SERVICE_ACCOUNT_JSON=
