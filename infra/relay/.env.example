# Self-Hosted Cove Control Plane (Relay + libp2p Tunnel Gateway)
# Copy to .env and fill in values before running `vp run --filter t3code-relay start`
# or `docker compose -f docker-compose.example.yml up`.

# HTTP listen bind host/port
HOST=0.0.0.0
PORT=8787

# Public base URL reachable by clients & environment hosts (no trailing slash)
RELAY_PUBLIC_URL=https://relay.example.com

# Persistent directory for auto-generated Ed25519 mint keys, tunnel secrets, and libp2p peer identity
RELAY_DATA_DIR=/data/relay

# PostgreSQL connection string
DATABASE_URL=postgres://cove:cove@localhost:5432/cove_relay
# Automatically apply SQL migrations from infra/relay/migrations/postgres on boot (default: true)
RELAY_AUTO_MIGRATE=true

# Standard external OIDC authentication (Discovery + JWKS + PKCE + Device Flow)
# Supports Keycloak, Authentik, Authelia, Dex, ZITADEL, Auth0, Okta, Google, Entra ID, etc.
RELAY_OIDC_ISSUER=https://auth.example.com/realms/cove
RELAY_OIDC_CLIENT_ID=cove-app
# Comma-separated scopes advertised to clients (default: openid,profile,email)
RELAY_OIDC_SCOPES=openid,profile,email
# Optional explicit audience and JWKS URI overrides (defaults to OIDC discovery)
# RELAY_OIDC_AUDIENCE=cove-app
# RELAY_OIDC_JWKS_URI=

# libp2p tunnel gateway
RELAY_LIBP2P_ENABLED=true
# Comma-separated libp2p listen multiaddrs
RELAY_LIBP2P_LISTEN=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws
# Comma-separated public multiaddrs advertised in /.well-known/cove-control-plane
# Example: /ip4/203.0.113.10/tcp/4001,/dns4/relay.example.com/tcp/4002/wss
# RELAY_LIBP2P_ANNOUNCE=
# Secret used to derive per-environment tunnel connector tokens (auto-generated in RELAY_DATA_DIR if omitted)
# RELAY_TUNNEL_SECRET=
# Optional subdomain routing base domain (defaults to path-prefix /t/<endpointKey>/ when unset)
# RELAY_TUNNEL_BASE_DOMAIN=tunnels.example.com
RELAY_TUNNEL_NAMESPACE=selfhosted
RELAY_MAX_MANAGED_TUNNELS=20

# Optional explicit Ed25519 keys for relay mint tokens (auto-generated in RELAY_DATA_DIR if omitted)
# RELAY_SIGNING_PRIVATE_KEY=
# RELAY_SIGNING_PUBLIC_KEY=

# Optional Apple Push Notification service (APNs)
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# RELAY_APNS_JOB_SECRET=

# Optional Firebase Cloud Messaging (Android push) service account JSON
# FCM_SERVICE_ACCOUNT_JSON=
